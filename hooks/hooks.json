{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/cli/run-node.sh\" \"${PLUGIN_ROOT:-${CLAUDE_PLUGIN_ROOT}}/cli/starmemory.mjs\" sync --background"
          }
        ]
      }
    ]
  }
}
